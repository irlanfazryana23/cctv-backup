<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CctvBackup.Desktop.Views.MessageDialog"
        Title="Notice"
        Icon="/Assets/logo.png"
        Width="460" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Margin="20">
        <ScrollViewer Grid.Row="0">
            <TextBlock x:Name="TxtMessage" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" LineHeight="20"/>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button x:Name="BtnOk" Classes="primary" Content="OK" Width="90" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
